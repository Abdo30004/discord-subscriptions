# ==============================================================================
# Discord Bot Subscription & Turnkey Fleet Management Platform
# Environment Configuration Template (.env.example)
#
# Copy this file to .env before starting the platform:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Global Runtime
# ------------------------------------------------------------------------------
ENV=development                          # development, staging, production
LOG_LEVEL=debug                          # debug, info, warn, error
DASHBOARD_URL=http://localhost           # Public URL for the web dashboard

# ------------------------------------------------------------------------------
# 2. Traefik Reverse Proxy & Unified Edge Gateway
# ------------------------------------------------------------------------------
# All external and inter-container traffic is routed through Traefik (Port 80).
TRAEFIK_HTTP_PORT=80                     # Unified public HTTP entrypoint
TRAEFIK_DASHBOARD_PORT=8090              # Traefik Web UI & Traffic Visualizer (:8090 on host)
TRAEFIK_URL=http://traefik               # Internal Docker network Traefik gateway address
GATEWAY_URL=http://traefik               # Alias for Traefik edge gateway

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Per Service (Isolated DBs & Scoped Users on platform-net)
# ------------------------------------------------------------------------------
# PostgreSQL Root Superuser (used by postgres container init)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres                   # "postgres" in Docker, "localhost" for local Go dev
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Per-Service Isolated Database Users (Principle of Least Privilege)
AUTH_DB_USER=auth_user
AUTH_DB_PASS=auth_pass
AUTH_DB_NAME=auth_db

CATALOG_DB_USER=catalog_user
CATALOG_DB_PASS=catalog_pass
CATALOG_DB_NAME=catalog_db

BILLING_DB_USER=billing_user
BILLING_DB_PASS=billing_pass
BILLING_DB_NAME=billing_db

DEPLOY_DB_USER=deploy_user
DEPLOY_DB_PASS=deploy_pass
DEPLOY_DB_NAME=deploy_db

MONITOR_DB_USER=monitor_user
MONITOR_DB_PASS=monitor_pass
MONITOR_DB_NAME=monitor_db

# ------------------------------------------------------------------------------
# 4. RabbitMQ Message Broker (AMQP 0-9-1 Topic Exchange)
# ------------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq                   # "rabbitmq" in Docker, "localhost" for local Go dev
RABBITMQ_PORT=5672                       # AMQP protocol port
RABBITMQ_MGMT_PORT=15672                 # Management Web UI port

# ------------------------------------------------------------------------------
# 5. HashiCorp Vault (Bot Tokens & Secret Storage)
# ------------------------------------------------------------------------------
VAULT_ADDR=http://vault:8200             # "http://vault:8200" in Docker, "http://localhost:8200" for local
VAULT_DEV_ROOT_TOKEN=root                # Dev mode root token (never use root token in prod)

# ------------------------------------------------------------------------------
# 6. Microservices Internal Ports (Zero Host Port Exports in Docker)
# ------------------------------------------------------------------------------
AUTH_SVC_PORT=8080
CATALOG_SVC_PORT=8081
BILLING_SVC_PORT=8082
DEPLOY_SVC_PORT=8083
MONITOR_SVC_PORT=8084

# ------------------------------------------------------------------------------
# 7. Discord Developer Application & OAuth2 Configuration
# ------------------------------------------------------------------------------
# Create an application in https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost/auth/callback

# ------------------------------------------------------------------------------
# 8. Central Manager Bot (Discord.js v14 Gateway & Slash Commands)
# ------------------------------------------------------------------------------
# Bot token and client ID for the in-chat manager bot
MANAGER_BOT_TOKEN=your_manager_bot_token
MANAGER_BOT_CLIENT_ID=your_manager_bot_client_id
HEALTH_PORT=8085                         # Internal health probe port (:8085 /health)

# Upstream Service URLs for Manager Bot (defaults to Traefik Edge Gateway)
CATALOG_SVC_URL=http://traefik
BILLING_SVC_URL=http://traefik
DEPLOY_SVC_URL=http://traefik
MONITOR_SVC_URL=http://traefik

# ------------------------------------------------------------------------------
# 9. PayPal Checkout & Webhooks Configuration
# ------------------------------------------------------------------------------
# Obtain credentials from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_MODE=sandbox                      # sandbox or live

# ------------------------------------------------------------------------------
# 10. Security, Authentication & Session Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-development-jwt-key-replace-in-production
# Comma-separated Discord Snowflake IDs with immutable Super Admin privileges
SUPER_ADMIN_DISCORD_IDS=123456789012345678

# ------------------------------------------------------------------------------
# 11. Kubernetes Orchestration (deploy-svc)
# ------------------------------------------------------------------------------
# Path to kubeconfig (optional; leaves empty to use in-cluster Pod service account)
# For Kubernetes deployments, copy k8s/03-secrets.example.yaml to k8s/03-secrets.yaml
KUBECONFIG=

# ------------------------------------------------------------------------------
# 12. Monitoring Telemetry & Health Polling (monitor-svc)
# ------------------------------------------------------------------------------
MONITOR_POLL_INTERVAL=15s                # Frequency of ping/health checks
MONITOR_WORKERS=5                        # Concurrent health inspection worker routines

# ------------------------------------------------------------------------------
# 13. Frontend Next.js Client Configuration (Relative paths through Traefik)
# ------------------------------------------------------------------------------
# In Docker behind Traefik, all values default to empty string "" (relative routing).
# For standalone local development without Traefik, set to http://localhost:808X.
NEXT_PUBLIC_AUTH_SVC_URL=
NEXT_PUBLIC_CATALOG_SVC_URL=
NEXT_PUBLIC_BILLING_SVC_URL=
NEXT_PUBLIC_DEPLOY_SVC_URL=
NEXT_PUBLIC_MONITOR_SVC_URL=
