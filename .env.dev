# ==============================================================================
# Discord Bot Subscription Platform - Development Environment (.env.dev)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Runtime & Environment
# ------------------------------------------------------------------------------
ENV=development
LOG_LEVEL=debug
DASHBOARD_URL=http://localhost
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Traefik Reverse Proxy & Unified Edge Gateway
# ------------------------------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8090
TRAEFIK_URL=http://traefik
GATEWAY_URL=http://traefik

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Per Service (Development Isolated DBs)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

AUTH_DB_USER=auth_user
AUTH_DB_PASS=auth_pass
AUTH_DB_NAME=auth_db

CATALOG_DB_USER=catalog_user
CATALOG_DB_PASS=catalog_pass
CATALOG_DB_NAME=catalog_db

BILLING_DB_USER=billing_user
BILLING_DB_PASS=billing_pass
BILLING_DB_NAME=billing_db

DEPLOY_DB_USER=deploy_user
DEPLOY_DB_PASS=deploy_pass
DEPLOY_DB_NAME=deploy_db

MONITOR_DB_USER=monitor_user
MONITOR_DB_PASS=monitor_pass
MONITOR_DB_NAME=monitor_db

# ------------------------------------------------------------------------------
# 4. RabbitMQ Message Broker (Development AMQP)
# ------------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ------------------------------------------------------------------------------
# 5. HashiCorp Vault (Development Ephemeral Engine)
# ------------------------------------------------------------------------------
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN=root

# ------------------------------------------------------------------------------
# 6. Microservices Internal Ports
# ------------------------------------------------------------------------------
AUTH_SVC_PORT=8080
CATALOG_SVC_PORT=8081
BILLING_SVC_PORT=8082
DEPLOY_SVC_PORT=8083
MONITOR_SVC_PORT=8084

# ------------------------------------------------------------------------------
# 7. Discord Developer Application & OAuth2 Configuration
# ------------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost/auth/callback

# ------------------------------------------------------------------------------
# 8. Central Manager Bot (Development Standalone Mode)
# ------------------------------------------------------------------------------
MANAGER_BOT_TOKEN=
MANAGER_BOT_CLIENT_ID=
HEALTH_PORT=8085
ENABLE_SHARDING=false

CATALOG_SVC_URL=http://traefik
BILLING_SVC_URL=http://traefik
DEPLOY_SVC_URL=http://traefik
MONITOR_SVC_URL=http://traefik

# ------------------------------------------------------------------------------
# 9. PayPal Checkout & Webhooks (Sandbox Mode)
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# ------------------------------------------------------------------------------
# 10. Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=dev-insecure-jwt-secret-key-for-local-development-only-replace-in-production
SUPER_ADMIN_DISCORD_IDS=123456789012345678

# ------------------------------------------------------------------------------
# 11. Monitoring Telemetry & Health Polling
# ------------------------------------------------------------------------------
MONITOR_POLL_INTERVAL=15s
MONITOR_WORKERS=5

# ------------------------------------------------------------------------------
# 12. Frontend Next.js Client
# ------------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_SVC_URL=
NEXT_PUBLIC_CATALOG_SVC_URL=
NEXT_PUBLIC_BILLING_SVC_URL=
NEXT_PUBLIC_DEPLOY_SVC_URL=
NEXT_PUBLIC_MONITOR_SVC_URL=
