{
  "name": "discord-subscriptions-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Discord Bot Subscription & Turnkey Fleet Management Platform",
  "scripts": {
    "changelog": "node scripts/generate-changelog.mjs",
    "changelog:check": "node scripts/generate-changelog.mjs --check",
    "test:go": "go test -v ./shared/... ./microservices/auth-svc/... ./microservices/catalog-svc/... ./microservices/billing-svc/... ./microservices/deploy-svc/... ./microservices/monitor-svc/...",
    "test:e2e": "go test -v ./tests/e2e/...",
    "build:bot": "npm --prefix bots/manager-bot run build",
    "build:frontend": "npm --prefix frontend run build",
    "compose:dev": "docker compose -f docker-compose.dev.yml --env-file .env.dev up -d",
    "compose:dev:down": "docker compose -f docker-compose.dev.yml --env-file .env.dev down",
    "compose:prod": "docker compose -f docker-compose.prod.yml --env-file .env.prod up -d",
    "compose:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.prod down",
    "validate:docker": "docker compose config --quiet && docker compose -f docker-compose.dev.yml --env-file .env.dev config --quiet && docker compose -f docker-compose.prod.yml --env-file .env.prod config --quiet",
    "validate:k8s": "kubectl kustomize k8s/",
    "validate:diagrams": "node scripts/validate-diagrams.mjs"
  },
  "keywords": [
    "discord",
    "bot",
    "subscriptions",
    "fleet",
    "turnkey",
    "golang",
    "nextjs",
    "kubernetes"
  ],
  "author": "Abdo30004",
  "license": "UNLICENSED",
  "devDependencies": {
    "jsdom": "^30.1.1",
    "mermaid": "^12.0.0"
  }
}
