# ==============================================================================
# Discord Bot Subscription Platform - Production Environment (.env.prod)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Runtime & Environment (Switches Go slog to JSONHandler)
# ------------------------------------------------------------------------------
ENV=production
LOG_LEVEL=info
DASHBOARD_URL=https://platform.yourdomain.com
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Traefik Reverse Proxy & Unified Edge Gateway
# ------------------------------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8090
TRAEFIK_URL=http://traefik
GATEWAY_URL=http://traefik

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Per Service (Production Isolated DBs & Strong Passwords)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=prod_secure_pg_master_pass_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

AUTH_DB_USER=auth_user
AUTH_DB_PASS=auth_prod_secure_pass_92f8a
AUTH_DB_NAME=auth_db

CATALOG_DB_USER=catalog_user
CATALOG_DB_PASS=catalog_prod_secure_pass_38a1b
CATALOG_DB_NAME=catalog_db

BILLING_DB_USER=billing_user
BILLING_DB_PASS=billing_prod_secure_pass_83c7d
BILLING_DB_NAME=billing_db

DEPLOY_DB_USER=deploy_user
DEPLOY_DB_PASS=deploy_prod_secure_pass_74e2f
DEPLOY_DB_NAME=deploy_db

MONITOR_DB_USER=monitor_user
MONITOR_DB_PASS=monitor_prod_secure_pass_51b9c
MONITOR_DB_NAME=monitor_db

# ------------------------------------------------------------------------------
# 4. RabbitMQ Message Broker (Production Scoped User)
# ------------------------------------------------------------------------------
RABBITMQ_USER=rabbit_prod_admin
RABBITMQ_PASS=rabbit_prod_pass_91e0a2
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ------------------------------------------------------------------------------
# 5. HashiCorp Vault (Production Persistent Vault)
# ------------------------------------------------------------------------------
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN=prod_vault_token_replace_with_unseal_token

# ------------------------------------------------------------------------------
# 6. Microservices Internal Ports
# ------------------------------------------------------------------------------
AUTH_SVC_PORT=8080
CATALOG_SVC_PORT=8081
BILLING_SVC_PORT=8082
DEPLOY_SVC_PORT=8083
MONITOR_SVC_PORT=8084

# ------------------------------------------------------------------------------
# 7. Discord Developer Application & OAuth2 Configuration
# ------------------------------------------------------------------------------
DISCORD_CLIENT_ID=production_discord_client_id
DISCORD_CLIENT_SECRET=production_discord_client_secret
DISCORD_REDIRECT_URI=https://platform.yourdomain.com/auth/callback

# ------------------------------------------------------------------------------
# 8. Central Manager Bot (Production Clustered Sharding Mode)
# ------------------------------------------------------------------------------
MANAGER_BOT_TOKEN=production_manager_bot_token
MANAGER_BOT_CLIENT_ID=production_manager_bot_client_id
HEALTH_PORT=8085
ENABLE_SHARDING=true

CATALOG_SVC_URL=http://traefik
BILLING_SVC_URL=http://traefik
DEPLOY_SVC_URL=http://traefik
MONITOR_SVC_URL=http://traefik

# ------------------------------------------------------------------------------
# 9. PayPal Checkout & Webhooks (Live Production Mode)
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=production_paypal_client_id
PAYPAL_CLIENT_SECRET=production_paypal_client_secret
PAYPAL_WEBHOOK_ID=production_paypal_webhook_id
PAYPAL_MODE=live

# ------------------------------------------------------------------------------
# 10. Security & Authentication (Strict Cryptographic Production Secret)
# ------------------------------------------------------------------------------
JWT_SECRET=prod_super_secure_jwt_secret_must_be_minimum_32_characters_long_replace_in_production
SUPER_ADMIN_DISCORD_IDS=123456789012345678

# ------------------------------------------------------------------------------
# 11. Monitoring Telemetry & Health Polling (Production Concurrency)
# ------------------------------------------------------------------------------
MONITOR_POLL_INTERVAL=15s
MONITOR_WORKERS=10

# ------------------------------------------------------------------------------
# 12. Frontend Next.js Client
# ------------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_SVC_URL=
NEXT_PUBLIC_CATALOG_SVC_URL=
NEXT_PUBLIC_BILLING_SVC_URL=
NEXT_PUBLIC_DEPLOY_SVC_URL=
NEXT_PUBLIC_MONITOR_SVC_URL=
